POSTGRES_USER=winterarc
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=winterarc

WINTERARC_API_KEY=change-me-to-a-long-random-key-for-the-companion-app
WINTERARC_BASE_URL=https://winterarc.your-tailnet.ts.net
WINTERARC_SYNC_INTERVAL=1h

# Provider credentials (FatSecret, Lyfta, Bend, HowWeFeel) live in the
# gitignored secrets/api-keys.txt dump file; copy what you need into .env.

PGDATA_HOST_PATH=/home/neo_phantom_byte/Documents/TheWinterArc/data/postgres

FATSECRET_KEY=
FATSECRET_SECRET=

# Caddy basic auth (Caddyfile serves :8081, TLS is terminated by Tailscale serve)
BASIC_AUTH_USER=winterarc
CADDY_BASIC_AUTH_HASH=run-docker-run---rm-caddy--2-caddy-hash-password